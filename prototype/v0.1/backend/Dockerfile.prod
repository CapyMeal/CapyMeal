FROM dunglas/frankenphp:1-php8.4-bookworm

RUN install-php-extensions pdo_pgsql zip gd

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copia el código de la app
COPY . .

# Instala dependencias de producción (--no-scripts evita package:discover sin .env)
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --quiet

# Permisos de storage (sin brace expansion para /bin/sh)
RUN mkdir -p storage/framework/sessions \
    storage/framework/views \
    storage/framework/cache \
    storage/framework/cache/data \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY entrypoint.prod.sh /entrypoint.sh
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

# FrankenPHP (Caddy) escucha en el puerto de SERVER_NAME; Render espera
# encontrar la app en el puerto 8000, igual que antes con "artisan serve".
ENV SERVER_NAME=":8000"

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
