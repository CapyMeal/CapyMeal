FROM dunglas/frankenphp:1-php8.4-bookworm

RUN install-php-extensions pdo_pgsql zip gd

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copia solo los manifests de Composer primero: mientras composer.lock no
# cambie, esta capa (instalar los paquetes de vendor/, la parte lenta)
# se reusa entre builds aunque el código de la app sí haya cambiado --
# antes, "COPY . ." completo corría antes del install, así que cualquier
# cambio de código (sin tocar composer.lock) invalidaba el cache y
# forzaba reinstalar todo en cada deploy.
COPY composer.json composer.lock ./

# --no-autoloader: el autoloader optimizado necesita ver los archivos
# reales de app/ para armar el classmap, que todavía no están copiados
# acá (--no-scripts evita package:discover sin .env, igual que antes).
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --quiet

# Recién ahora se copia el código real de la app.
COPY . .

# Con el código ya presente, se genera el autoloader optimizado -- rápido,
# corre en cada build sin afectar el cache de la capa anterior. --no-scripts
# por la misma razón que el install de arriba: package:discover necesita un
# .env que todavía no existe en este punto del build.
RUN composer dump-autoload --optimize --no-interaction --no-scripts --quiet

# Permisos de storage (sin brace expansion para /bin/sh)
RUN mkdir -p storage/framework/sessions \
    storage/framework/views \
    storage/framework/cache \
    storage/framework/cache/data \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY entrypoint.prod.sh /entrypoint.sh
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

# El binario de frankenphp trae por defecto la capability CAP_NET_BIND_SERVICE
# (para poder bindear puertos <1024 sin ser root). El sandbox de Render no
# permite ejecutar binarios con capabilities de Linux -- el exec falla con
# "Operation not permitted", sin importar el usuario. Servimos en :8000 (no
# privilegiado), así que no la necesitamos: se la sacamos.
RUN setcap -r /usr/local/bin/frankenphp

# Corre como usuario sin privilegios: FrankenPHP no necesita ser root una vez
# que no bindea puertos privilegiados. /config/caddy y /data/caddy son donde
# Caddy guarda su config autoguardada y su storage interno.
RUN useradd --create-home appuser \
    && chown -R appuser:appuser /app /config/caddy /data/caddy
USER appuser

# FrankenPHP (Caddy) escucha en el puerto de SERVER_NAME; Render espera
# encontrar la app en el puerto 8000, igual que antes con "artisan serve".
ENV SERVER_NAME=":8000"

# La imagen base trae la API de administración de Caddy (puerto 2019),
# pensada para reconfigurar Caddy en caliente vía HTTP -- no la usamos,
# nuestra config sale del Caddyfile al arrancar. En Render, algo dentro
# de su red interna le pega a ese puerto con el hostname público como
# Host, y Caddy lo rechaza por diseño (su admin API sólo acepta
# localhost/127.0.0.1, para evitar DNS rebinding). Sacar el HEALTHCHECK
# no alcanzó para que dejara de pasar -- la apagamos del todo: no hay
# nada escuchando en 2019, así que no hay nada que rechazar.
ENV CADDY_GLOBAL_OPTIONS="admin off"

EXPOSE 8000

HEALTHCHECK NONE

ENTRYPOINT ["/entrypoint.sh"]
