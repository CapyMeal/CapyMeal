APP_NAME=CapyMeal
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local (docker-compose): pgsql contra el contenedor "db".
# Producción (Render): se usa DATABASE_URL con la connection string de
# Neon en su lugar -- ver entrypoint.prod.sh.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=capymeal
DB_USERNAME=capymeal
DB_PASSWORD=capymeal

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# URL del frontend (para CORS). En producción, la URL de Vercel.
FRONTEND_URL=http://localhost:5174

# Dominios desde los que Sanctum acepta auth por cookie de sesión (en vez de
# bearer token) -- tienen que incluir el host:puerto real del frontend, no
# alcanza con "localhost" pelado si el puerto es distinto. En producción
# (Render, vía entrypoint.prod.sh) esto se deriva solo de FRONTEND_URL, no
# hace falta setearlo a mano.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:4173

# Sin estos dos, ok en local (frontend y backend son "same-site" al compartir
# host "localhost", sólo cambia el puerto). En producción son obligatorios
# porque frontend (Vercel) y backend (Render) son dominios distintos de
# verdad -- sin SameSite=none la cookie de sesión no viaja entre ambos, y
# SameSite=none exige Secure. entrypoint.prod.sh ya los fija así, no hace
# falta setearlos en el dashboard de Render:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none

# OAuth Client de Google Cloud Console (Web application). GOOGLE_REDIRECT_URI
# tiene que ser el puerto real mapeado al host (8080), no el interno del
# contenedor (8000, que es APP_URL) -- y coincidir carácter por carácter con
# la URI autorizada en Google Cloud Console. En producción:
# https://capymeal.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# App registration de Azure/Microsoft Entra admin center. Mismo razonamiento
# que GOOGLE_REDIRECT_URI de arriba (puerto real 8080, no el interno 8000).
# En producción: https://capymeal.onrender.com/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# Secreto compartido con .github/workflows/scheduler.yml -- Render no tiene
# cron jobs en el plan free, así que ese workflow es el que dispara el
# scheduler de Laravel una vez al día (ver routes/console.php). Generar con
# `openssl rand -hex 32` y cargar el mismo valor como secret de GitHub
# Actions (SCHEDULER_TOKEN).
SCHEDULER_TOKEN=

# Sentry (error tracking) — DSN del proyecto "capymeal-backend" en sentry.io
SENTRY_LARAVEL_DSN=

# Envio de mail: usamos SMTP (ej. Brevo, plan gratuito) porque no
# requiere verificar un dominio propio -- alcanza con verificar un solo
# email remitente para poder mandarle a cualquier usuario.
# Alternativa: MAIL_MAILER=resend + RESEND_API_KEY (mejor entregabilidad,
# pero exige dominio propio verificado para mandarle a cualquiera).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@capymeal.app"
MAIL_FROM_NAME="CapyMeal"
