APP_NAME=CapyMeal
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local (docker-compose): pgsql contra el contenedor "db".
# Producción (Render): se usa DATABASE_URL con la connection string de
# Neon en su lugar -- ver entrypoint.prod.sh.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=capymeal
DB_USERNAME=capymeal
DB_PASSWORD=capymeal

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# URL del frontend (para CORS). En producción, la URL de Vercel.
FRONTEND_URL=http://localhost:5174

# OAuth Client de Google Cloud Console (Web application). GOOGLE_REDIRECT_URI
# tiene que ser el puerto real mapeado al host (8080), no el interno del
# contenedor (8000, que es APP_URL) -- y coincidir carácter por carácter con
# la URI autorizada en Google Cloud Console. En producción:
# https://capymeal.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Sentry (error tracking) — DSN del proyecto "capymeal-backend" en sentry.io
SENTRY_LARAVEL_DSN=

# Envio de mail: usamos SMTP (ej. Brevo, plan gratuito) porque no
# requiere verificar un dominio propio -- alcanza con verificar un solo
# email remitente para poder mandarle a cualquier usuario.
# Alternativa: MAIL_MAILER=resend + RESEND_API_KEY (mejor entregabilidad,
# pero exige dominio propio verificado para mandarle a cualquiera).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@capymeal.app"
MAIL_FROM_NAME="CapyMeal"
